# Copy this file to `.env` and fill in the paths below ONLY if you want to
# re-train the CtD flip-flop distillation or re-run the BTCA ring analysis from
# scratch. The bundled checkpoints in models/ reproduce the figures without them.

# Checkout of the Computation-through-Dynamics toolkit (for the 3-bit flip-flop).
# https://github.com/snel-repo/ComputationThroughDynamicsToolkit
CTD_TOOLKIT_DIR=

# Directory containing the BTCA recttanh checkpoints (result_dict_*.pickle),
# for the real head-direction ring figure.
BTCA_CHECKPOINTS_DIR=

# Optional: override the output / checkpoint directories (default ./figures, ./models).
# UAP_FIGDIR=
# UAP_MODELDIR=
